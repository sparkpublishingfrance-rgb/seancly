# Projet Supabase dédié à Seancly.
# Copier ce fichier en `.env`, puis remplir avec les valeurs du dashboard,
# rubrique Project Settings, API.
#
# Seule la clé anonyme a sa place ici : elle est publique par conception et
# protégée par la RLS. La clé service_role ne doit jamais approcher le client,
# ni ce fichier, ni le bundle.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
